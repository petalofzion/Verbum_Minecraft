{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Verbum Agent Task Packet",
  "type": "object",
  "required": [
    "task_id",
    "role",
    "objective",
    "allowed_paths",
    "must_read",
    "success_criteria",
    "stop_conditions",
    "required_checks",
    "max_iterations",
    "report_schema"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "enum": ["capsule", "repo"]
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "allowed_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "must_read": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "success_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_checks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "max_iterations": {
      "type": "integer",
      "minimum": 1
    },
    "report_schema": {
      "type": "string",
      "minLength": 1
    },
    "context_bundle": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "handoff_inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "priority": {
      "type": "string",
      "enum": ["low", "normal", "high"]
    }
  },
  "additionalProperties": true
}
