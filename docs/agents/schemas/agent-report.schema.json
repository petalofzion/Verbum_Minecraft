{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Verbum Agent Final Report",
  "type": "object",
  "required": [
    "task_id",
    "status",
    "blocker_category",
    "summary",
    "files_touched",
    "files_read",
    "commands_run",
    "evidence",
    "blockers",
    "next_action",
    "gotchas_checked",
    "verification_summary"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["done", "blocked", "needs_contract", "needs_review", "failed"]
    },
    "blocker_category": {
      "type": "string",
      "enum": ["none", "environment", "scope", "contract", "verification", "requirements", "unknown"]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "files_touched": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "files_read": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "commands_run": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_action": {
      "type": "string"
    },
    "gotchas_checked": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification_summary": {
      "type": "string"
    },
    "separation_verdict": {
      "type": "string",
      "enum": ["pass", "needs_review", "blocked"]
    },
    "boundary_checks_run": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "boundary_findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "architecture_audit_summary": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
