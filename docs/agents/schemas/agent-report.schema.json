{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Verbum Agent Final Report",
  "type": "object",
  "required": [
    "task_id",
    "status",
    "summary",
    "files_touched",
    "files_read",
    "commands_run",
    "evidence",
    "blockers",
    "next_action"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["done", "blocked", "needs_contract", "needs_review", "failed"]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "files_touched": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "files_read": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "commands_run": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_action": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
