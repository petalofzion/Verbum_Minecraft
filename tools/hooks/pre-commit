#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
"${repo_root}/tools/scripts/update_todo_index.sh"
"${repo_root}/tools/scripts/update_contract_index.sh"
python3 "${repo_root}/tools/scripts/update_module_manifest.py"
python3 "${repo_root}/tools/scripts/update_capsule_index.py"
git add "${repo_root}/docs/TODO_INDEX.md"
git add "${repo_root}/docs/contracts/CONTRACT_INDEX.md"
git add "${repo_root}/modules/modules.toml"
git add "${repo_root}/docs/CAPSULE_INDEX.md"
git add "${repo_root}/docs/CAPSULE_INDEX.tsv"
