{
  "type": "object",
  "required": ["operations"],
  "properties": {
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["op"],
        "properties": {
          "op": {
            "type": "string",
            "enum": [
              "rename_group",
              "rename_region",
              "set_group_mode",
              "set_group_transform_policy",
              "set_group_flags",
              "create_group_set",
              "add_group_to_set",
              "remove_group_from_set",
              "merge_groups",
              "create_zone_from_rect",
              "create_zone_from_group",
              "delete_zone"
            ]
          },
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "group": { "type": "string", "minLength": 1 },
          "mode": {
            "type": "string",
            "enum": ["locked", "recolor_only", "detail", "motif", "free_paint", "shade_only"]
          },
          "transform_policy": {
            "type": "string",
            "enum": ["flat_recolor", "preserve_value", "palette_projection", "hue_bias_remap", "contrast_preserving_recolor"]
          },
          "preserve_value": { "type": "boolean" },
          "preserve_local_contrast": { "type": "boolean" },
          "quantize_to_palette": { "type": "boolean" },
          "name": { "type": "string", "minLength": 1 },
          "members": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "set": { "type": "string", "minLength": 1 },
          "sources": {
            "type": "array",
            "minItems": 2,
            "items": { "type": "string", "minLength": 1 }
          },
          "target": { "type": "string", "minLength": 1 },
          "rect": {
            "type": "object",
            "required": ["x", "y", "width", "height"],
            "properties": {
              "x": { "type": "integer", "minimum": 0 },
              "y": { "type": "integer", "minimum": 0 },
              "width": { "type": "integer", "minimum": 1 },
              "height": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
