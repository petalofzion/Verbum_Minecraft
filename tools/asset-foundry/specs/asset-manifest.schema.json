{
  "type": "object",
  "required": [
    "asset_id",
    "display_name",
    "profile",
    "asset_type",
    "material_palette",
    "style_tags",
    "mask_id",
    "output",
    "provenance",
    "review"
  ],
  "properties": {
    "asset_id": {
      "type": "string",
      "minLength": 1
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "type": "string",
      "enum": ["veritas", "vocations", "visions", "vorago"]
    },
    "asset_type": {
      "type": "string",
      "minLength": 1
    },
    "material_palette": {
      "type": "string",
      "minLength": 1
    },
    "style_tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "mask_id": {
      "type": "string",
      "minLength": 1
    },
    "output": {
      "type": "object",
      "required": ["resource_root", "files"],
      "properties": {
        "resource_root": {
          "type": "string",
          "minLength": 1
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["requested_by", "generator_mode"],
      "properties": {
        "requested_by": {
          "type": "string",
          "minLength": 1
        },
        "generator_mode": {
          "type": "string",
          "enum": ["pixel_native", "repair_generated_png", "draft_only"]
        },
        "prompt_summary": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "required": ["status", "notes"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["draft", "approved", "rejected"]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
