{
  "type": "object",
  "required": [
    "id",
    "asset_type",
    "base_mask",
    "palette_roles",
    "regions",
    "locked_regions",
    "free_paint_regions",
    "symmetry",
    "engine_support",
    "notes"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "asset_type": { "type": "string", "minLength": 1 },
    "base_mask": { "type": "string", "minLength": 1 },
    "base_reference": {
      "type": "object",
      "required": ["kind", "asset_path"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "asset_path": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "notes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "palette_roles": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "regions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "mode", "rects", "allowed_palette_roles", "default_palette_role", "optional"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "mode": {
            "type": "string",
            "enum": ["locked", "recolor_only", "motif", "free_paint", "shade_only"]
          },
          "rects": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["x", "y", "width", "height"],
              "properties": {
                "x": { "type": "integer", "minimum": 0 },
                "y": { "type": "integer", "minimum": 0 },
                "width": { "type": "integer", "minimum": 1 },
                "height": { "type": "integer", "minimum": 1 }
              },
              "additionalProperties": false
            }
          },
          "allowed_palette_roles": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "default_palette_role": { "type": "string", "minLength": 1 },
          "optional": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "locked_regions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "free_paint_regions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "symmetry": {
      "type": "string",
      "enum": ["none", "vertical"]
    },
    "engine_support": {
      "type": "object",
      "required": ["repair_generated_png", "pixel_native"],
      "properties": {
        "repair_generated_png": { "type": "boolean" },
        "pixel_native": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "notes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false
}
